# Copy to .env before running the frontend: cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and only via import.meta.env.
# process.env / REACT_APP_* do NOT work here — Vite rewrites process.env to {},
# so any REACT_APP_ read silently evaluates to undefined.

# Backend base path. "/api" is proxied to http://localhost:8080 by vite.config.js.
VITE_API_BASE_URL=/api

# AR / 3D asset buckets (public S3)
VITE_AR_IMAGE_BASE_URL=https://quickart-s3-assets.s3.eu-north-1.amazonaws.com
VITE_AR_MODEL_BASE_URL=https://quickart-s3-assets.s3.eu-north-1.amazonaws.com

# Cloudinary cloud name — public identifier, safe to ship in the bundle.
# Uploads are authorised by a signature fetched from the backend, never an API secret.
VITE_CLOUDINARY_CLOUD_NAME=djntpek30
